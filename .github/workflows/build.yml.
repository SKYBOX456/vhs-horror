name: Build mod
on: workflow_dispatch
jobs:
  build:
    runs-on: ubuntu-latest
    steps:
      - uses: actions/checkout@v4
      - run: unzip -q ./*.zip
      - uses: actions/setup-java@v4
        with:
          distribution: temurin
          java-version: 17
      - uses: gradle/actions/setup-gradle@v3
        with:
          gradle-version: 8.5
      - run: gradle build
        working-directory: vhs-horror
      - uses: actions/upload-artifact@v4
        with:
          name: vhs-horror-mod
          path: vhs-horror/build/libs/*.jar
